{
  "name": "etabook",
  "version": "0.1.0",
  "description": "A modern WYSIWYG Markdown editor for the desktop.",
  "type": "module",
  "main": "./out/main/index.js",
  "author": "etabook",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
